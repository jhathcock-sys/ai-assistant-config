# ChromaDB Connection Settings
# Copy this to .env and fill in actual values

# ChromaDB server details (Dell Stronghold)
CHROMADB_HOST=192.168.1.60
CHROMADB_PORT=8000

# Authentication token (same as in ~/Documents/.env)
# Generate with: openssl rand -hex 32
CHROMADB_AUTH_TOKEN=your_chromadb_auth_token_here

# Source paths for ingestion
# Claude Code configuration directory
CLAUDE_CONFIG_DIR=/home/cib/ai-assistant-config

# Obsidian vault (if using)
OBSIDIAN_VAULT_DIR=/home/cib/Documents/homelab-docs

# Homelab operations repository
HOMELAB_OPS_DIR=/home/cib/homelab-ops
